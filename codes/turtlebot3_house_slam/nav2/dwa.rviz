Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Alpha: 1
      Enabled: true
      Value: true
      Topic: {Value: /map, Durability Policy: Transient Local, Reliability Policy: Reliable, History Policy: Keep Last, Depth: 1}
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Value: true
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Topic: {Value: /scan, Reliability Policy: Best Effort}
    - Class: rviz_default_plugins/Path
      Name: A* global plan
      Enabled: true
      Value: true
      Color: 42; 120; 214
      Line Style: Billboards
      Line Width: 0.05
      Topic: {Value: /plan}
    - Class: rviz_default_plugins/Path
      Name: DWA chosen arc
      Enabled: true
      Value: true
      Color: 235; 104; 52
      Line Style: Billboards
      Line Width: 0.09
      Topic: {Value: /local_plan}
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Robot (AMCL)
      Enabled: true
      Value: true
      Shape: Arrow
      Shaft Length: 0.3
      Shaft Radius: 0.07
      Head Length: 0.2
      Head Radius: 0.14
      Color: 27; 175; 122
      Covariance: {Value: false}
      Topic: {Value: /amcl_pose, Durability Policy: Transient Local, Reliability Policy: Reliable}
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Names: false
      Marker Scale: 1
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      X: 2
      Y: -1
Window Geometry:
  X: 40
  Y: 50
  Width: 1500
  Height: 900
